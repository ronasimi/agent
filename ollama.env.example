# Apply these on the actual Ollama server/container, not on agent/agent-worker.
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_MAX_QUEUE=8
OLLAMA_NUM_PARALLEL=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
# Optional; use the lowest value that meets your latency/quality needs.
# OLLAMA_KEEP_ALIVE=5m
# Fast-model API calls use agent.fast_model_keep_alive: 0 by default, so the
# 2B helper is unloaded after each request even if the server default is longer.
# If only one model should ever remain loaded, also set OLLAMA_MAX_LOADED_MODELS=1.
