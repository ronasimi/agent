# Apply these on the actual Ollama server/container, not on agent/agent-worker.
# Steady-state interactive residency is executor(1.5B coder) + decision(0.5B coder).
# The 4B reasoning role is lazy: the harness evicts decision before escalation
# and restores decision asynchronously after foreground reasoning completes.
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_MAX_QUEUE=8
OLLAMA_NUM_PARALLEL=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
# Optional; use the lowest value that meets your latency/quality needs.
# OLLAMA_KEEP_ALIVE=5m
# Keep executor/support and decision roles resident via harness keep_alive=-1.
# If the machine cannot comfortably hold both, disable decision_model_prewarm or
# set decision_model_keep_alive=0; the deterministic paths remain functional.
# The optional nomic-embed-text model is not required while
# semantic_memory_enabled=false.
