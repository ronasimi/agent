# Apply these on the actual Ollama server/container, not on agent/agent-worker.
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_MAX_QUEUE=8
OLLAMA_NUM_PARALLEL=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
# Optional; use the lowest value that meets your latency/quality needs.
# OLLAMA_KEEP_ALIVE=5m
# The default harness config uses agent.fast_model_keep_alive=-1 so the 2B fast
# role stays resident after prewarm. Set that harness option to 0 if main+fast
# cannot coexist comfortably. If only one model should ever remain loaded, also
# set OLLAMA_MAX_LOADED_MODELS=1. The optional nomic-embed-text model is not
# required while semantic_memory_enabled=false.
